# ==========================================

backend/venv/
backend/.venv/
backend/env/
backend/ENV/

backend/__pycache__/
backend/**/__pycache__/
backend/*.py[cod]
backend/**/*.py[cod]

# Pytest
backend/.pytest_cache/

# Coverage
backend/.coverage
backend/.coverage.*
backend/htmlcov/

# Python build files
backend/build/
backend/dist/
backend/*.egg-info/
backend/**/*.egg-info/

